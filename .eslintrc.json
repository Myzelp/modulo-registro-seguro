{
    "env": {
        "node": true,
        "es6": true
    },
    "rules": {
        "no-eval": "error",
        "no-implied-eval": "error",
        "no-new-func": "error",
        "no-script-url": "error",
        "no-unsafe-finally": "error",
        "no-unsafe-negation": "error",
        "no-console": "off",
        "no-debugger": "warn"
    }
}